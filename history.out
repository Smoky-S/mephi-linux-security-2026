    1  sudo dnf update -y
    2  sudo dnf install -y git
    3  git --version 
    4  mkdir -p ~/mephi-linux-security-2026
    5  sudo groupadd students
    6  sudo useradd -u 1234 -m -G students -s /bin/bash user1
    7  sudo passwd user1
    8  sudo chage -M 90 user1
    9  id user1 
   10  sudo chage -l user1
   11  grep `^user1:` /etc/passwd
   12  grep '^user1:' /etc/passwd
   13  grep '^students:' /etc/group
   14  sudo grep '^user1:' /etc/shadow
   15  cat /etc/passwd > ~/mephi-linux-security-2026/passwd
   16  sudo cat /etc/shadow > ~/mephi-linux-security-2026/shadow
   17  cat /etc/group > ~/mephi-linux-security-2026/group
   18  sudo find / -xdev -type f -perm -4000 -ls > ~/find-suid.out 2>/dev/null
   19  less ~/find-suid.out
   20  ls -l ~/find-suid.out
   21  cat ~/ps-privileged.out
   22  ps -eo ruid,euid,pid,comm --sort=pid > ~/ps-privileged.out
   23  ls -l ~/ps-privileged.out
   24* 
   25  ps -eo ruid,euid,pid,comm | awk '$1 != 0 && $2 == 0 {print}' > ~/ps-privileged.out
   26  ~/ps-privileged.out
   27  cat ~/ps-privileged.out
   28  mkdir -p /home/user1/bin
   29  sudo mkdir -p /home/user1/bin
   30  sudo cp /usr/bin/cat /home/user1/bin/cat
   31  sudo chown root:root /home/user1/bin/cat
   32  sudo chmod 4755 /home/user1/bin/cat
   33  ls -l /home/user1/bin/cat
   34  sudo ls -l /home/user1/bin/cat
   35  su - user1
   36  sudo cp /usr/bin/chown /home/user1/bin/chown
   37  sudo chown root:root /home/user1/bin/chown
   38  sudo chmod 755 /home/user1/bin/chown
   39  sudo setcap cap_chown=ep /home/user1/bin/chown
   40  getcap /home/user1/bin/chown
   41  sudo getcap /home/user1/bin/chown
   42  su - user1
   43  sudo tee /etc/sudoers.d/time > /dev/null <<'EOF'
user1 ALL=(root) NOPASSWD: /usr/bin/date, /usr/bin/timedatectl
EOF

   44  sudo visudo -cf /etc/sudoers.d/time
   45  su - user1
   46  mkdir -p ~/mephi-linux-security-2026
   47  cp ~/find-suid.out ~/ps-privileged.out ~/mephi-linux-security-2026/
   48  sudo cp /etc/passwd /etc/shadow /etc/group /etc/sudoers ~/mephi-linux-security-2026/
   49  sudo sed -i 's/^\([^:]*\):[^:]*:/\1:x:/' ~/mephi-linux-security-2026/shadow
   50  sudo stat /home/user1 > ~/mephi-linux-security-2026/stat.out && sudo stat /home/user1/bin/cat >> ~/mephi-linux-security-2026/stat.out && sudo stat /home/user1/bin/chown >> ~/mephi-linux-security-2026/stat.out
   51  getcap /home/user1/bin/chown > ~/mephi-linux-security-2026/getcap.out
   52  sudo getcap /home/user1/bin/chown > ~/mephi-linux-security-2026/getcap.out
   53  history > ~/mephi-linux-security-2026/history.out
